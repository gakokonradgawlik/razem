# Names and safe defaults only; no credentials. Accounts are created with
# `npm run admin -- bootstrap` (passwords via stdin).
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=./data/razem.sqlite
# Production Compose: host port; ToDo HTTP_PORT wins. Legacy RAZEM_PORT is still supported.
HTTP_PORT=3000
RAZEM_BIND_ADDRESS=127.0.0.1
# Optional explicit free IPv4 subnet, chosen before first installation.
# Installer/compose.sh adds compose.subnet.yaml only when set; empty uses automatic IPAM.
RAZEM_NETWORK_SUBNET=
RAZEM_PUBLIC_ORIGIN=
RAZEM_TRUST_PROXY=
# Host development server (npm start/dev) uses the unprefixed names below.
# Set the exact real HTTPS origin in production (no path/trailing slash).
PUBLIC_ORIGIN=
# Reverse proxy address(es) whose X-Forwarded-* are trusted, e.g. 127.0.0.1; empty = none.
TRUST_PROXY=
# Development over plain http://127.0.0.1 only. Rejected when NODE_ENV=production.
COOKIE_SECURE=false
# Argon2id cost; defaults RFC 9106 (64 MiB, t=3, p=4). Measure: admin measure-argon2.
ARGON2_MEMORY_KIB=
ARGON2_PASSES=
ARGON2_PARALLELISM=

# Optional Web Push; one stable pair shared by app and worker. Keep private key outside Git.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Installer: APP_VERSION is supplied by ToDo; private bootstrap comes from either
# RAZEM_BOOTSTRAP_JSON (private ToDo setting) or RAZEM_BOOTSTRAP_FILE (0600 JSON).
# Never put passwords in this example or a tracked file. See operations/ubuntu.md.
