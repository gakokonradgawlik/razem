# Names and safe defaults only; no credentials. Accounts are created with
# `npm run admin -- bootstrap` (passwords via stdin).
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=./data/razem.sqlite
# Compose publishes only on loopback; change the port if occupied.
RAZEM_PORT=3100
# Exact HTTPS origin of the PWA in production (CSRF/Origin check), e.g. https://razem.example
PUBLIC_ORIGIN=
# Reverse proxy address(es) whose X-Forwarded-* are trusted, e.g. 127.0.0.1; empty = none.
TRUST_PROXY=
# Development over plain http://127.0.0.1 only. Rejected when NODE_ENV=production.
COOKIE_SECURE=false
# Argon2id cost; defaults RFC 9106 (64 MiB, t=3, p=4). Measure: admin measure-argon2.
ARGON2_MEMORY_KIB=
ARGON2_PASSES=
ARGON2_PARALLELISM=

# Optional Web Push; one stable pair shared by app and worker. Keep private key outside Git.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
