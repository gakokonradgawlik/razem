{
  "name": "razem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build -w @razem/contracts && npm run build -w @razem/db && npm run build -w @razem/server && npm run build -w @razem/worker && npm run build -w @razem/web",
    "start": "node --env-file-if-exists=.env apps/server/dist/index.js",
    "admin": "node --env-file-if-exists=.env apps/server/dist/admin.js",
    "admin:dev": "node --env-file-if-exists=.env --conditions=development --import=tsx apps/server/src/admin.ts",
    "test:e2e": "playwright test",
    "ci": "npm run typecheck && npm test && npm run build && npm run test:e2e && docker compose -f deploy/compose.yaml config --quiet"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@types/better-sqlite3": "9.6.0"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "14.0.3"
    }
  }
}
